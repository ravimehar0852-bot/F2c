rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    // Admin flag: a user may read only their own admins/<uid> doc. Nobody can write from the client.
    match /admins/{uid} {
      allow get: if owns(uid);
      allow list, write: if false;
    }

    // Customer profile, created once at registration.
    match /customers/{uid} {
      allow create: if owns(uid) && request.resource.data.uid == uid;
      allow get: if owns(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;

      match /notifications/{nid} {
        allow read: if owns(uid) || isAdmin();
        allow create: if isAdmin();
        allow update: if owns(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }
    }

    // Loan applications: customer creates (status must be Submitted), only admin changes them.
    match /applications/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'Submitted';
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Admin-managed records. Customers can read only the ones marked visibleToCustomer.
    match /{col}/{id} {
      allow read: if (col in ['agreements', 'rtgsRecords', 'complianceReviews']) && signedIn() && resource.data.uid == request.auth.uid && resource.data.visibleToCustomer == true;
      allow read: if (col in ['agreements', 'rtgsRecords', 'complianceReviews', 'tdsRecords', 'gstRecords', 'nocRecords']) && isAdmin();
      allow create, update: if (col in ['agreements', 'rtgsRecords', 'complianceReviews', 'tdsRecords', 'gstRecords', 'nocRecords']) && isAdmin();
    }

    match /auditLogs/{id} {
      allow create: if isAdmin() && request.resource.data.actor == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Website enquiry / contact forms (collection names: adjust to what your forms use).
    match /{col}/{id} {
      allow create: if (col in ['enquiries', 'contacts', 'messages']) && request.resource.data.keys().size() < 30;
      allow read, update, delete: if (col in ['enquiries', 'contacts', 'messages']) && isAdmin();
    }
  }
}
