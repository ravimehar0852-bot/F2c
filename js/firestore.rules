rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }   // admin = a document admins/<uid> created in Firebase Console
    function mine(uid) { return signed() && request.auth.uid == uid; }
    function ownsDoc() { return signed() && resource.data.uid == request.auth.uid; }

    /* ---- Public website forms (create-only) ---- */
    match /enquiries/{id} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name','mobile','email','loanType','amount','employment','income','city','consent','source','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')
        && request.resource.data.email is string && request.resource.data.email.size() <= 120 && request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && request.resource.data.loanType is string && request.resource.data.loanType.size() <= 30
        && request.resource.data.amount is number && request.resource.data.amount >= 10000 && request.resource.data.amount <= 100000000
        && request.resource.data.employment is string && request.resource.data.employment.size() <= 40
        && request.resource.data.income is string && request.resource.data.income.size() <= 40
        && request.resource.data.city is string && request.resource.data.city.size() >= 2 && request.resource.data.city.size() <= 60
        && request.resource.data.consent == true && request.resource.data.source is string && request.resource.data.source.size() <= 30
        && request.resource.data.createdAt == request.time;
    }
    match /contactMessages/{id} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name','mobile','email','loanType','message','consent','source','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')
        && request.resource.data.email is string && request.resource.data.email.size() <= 120 && request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && request.resource.data.loanType is string && request.resource.data.loanType.size() <= 30
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 1000
        && request.resource.data.consent == true && request.resource.data.source is string && request.resource.data.source.size() <= 30
        && request.resource.data.createdAt == request.time;
    }

    /* ---- Company settings: loan terms are public (shown on website), everything else admin-only ---- */
    match /settings/loanTerms { allow read: if true; allow write: if isAdmin(); }
    match /settings/{other} { allow read, write: if isAdmin(); }

    /* ---- ID reservation: every Customer ID / Application ID can be created ONCE (uniqueness is enforced here) ---- */
    match /idIndex/{id} {
      allow read: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid','kind','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.kind == 'customer' && id.matches('^CID-[0-9]{2}-[A-HJ-NP-Z2-9]{6}$'))
         || (request.resource.data.kind == 'application' && id.matches('^APP-[0-9]{4}-[A-HJ-NP-Z2-9]{6}$')));
      allow update, delete: if false;
    }
    match /registrations/{uid} {
      allow read: if mine(uid) || isAdmin();
      allow create: if mine(uid)
        && request.resource.data.keys().hasOnly(['customerId','applicationId','createdAt'])
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/idIndex/$(request.resource.data.customerId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/idIndex/$(request.resource.data.applicationId)).data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    /* ---- Customers: created by the customer ONLY with the ID reserved for them; admin-owned fields are fixed ---- */
    match /customers/{uid} {
      allow read: if mine(uid) || isAdmin();
      allow create: if mine(uid)
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/registrations/$(uid))
        && get(/databases/$(database)/documents/registrations/$(uid)).data.customerId == request.resource.data.customerId
        && request.resource.data.keys().hasOnly(['uid','customerId','name','fullName','phone','mobile','email','dob','aadhaar','aadhaarLast4','pan','city','state','pincode','addressCurrent','addressPermanent','empType','employmentType','employer','employerName','monthlyIncome','workYears','employmentMonths','hasOtherLoans','otherObligations','bankName','accountHolder','accountNumber','accountLast4','ifsc','refName','refPhone','refRelation','identityStatus','addressStatus','docsStatus','status','createdAt','updatedAt'])
        && request.resource.data.identityStatus == 'Pending verification'
        && request.resource.data.addressStatus == 'Pending verification'
        && request.resource.data.docsStatus == 'Pending'
        && request.resource.data.status == 'Active'
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
      // after registration a customer may change ONLY location fields; verified data needs admin re-verification
      allow update: if isAdmin() || (mine(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['city','state','pincode','addressCurrent','addressPermanent','updatedAt']));
      match /notifications/{n} { allow read: if mine(uid) || isAdmin(); allow create: if isAdmin(); allow update: if mine(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']); allow delete: if false; }
      match /communications/{c} { allow read, create: if isAdmin(); allow update, delete: if false; }
    }

    /* ---- Applications: the customer can only create their own "Submitted" application with the reserved ID; only admins change it ---- */
    match /applications/{id} {
      allow read: if ownsDoc() || isAdmin();
      allow create: if signed()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.applicationId
        && exists(/databases/$(database)/documents/registrations/$(request.auth.uid))
        && get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.applicationId == request.resource.data.applicationId
        && get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.customerId == request.resource.data.customerId
        && request.resource.data.keys().hasOnly(['uid','applicationId','customerId','customerName','loanType','loanAmount','tenureMonths','purpose','monthlyIncome','employmentType','otherObligations','hasOtherLoans','emiRate','estimatedEmi','status','statusHistory','createdAt','updatedAt'])
        && request.resource.data.status == 'Submitted'
        && request.resource.data.loanAmount is number && request.resource.data.loanAmount > 0
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
      allow update: if isAdmin();
    }

    /* ---- Admin modules: admin-only; customers can read only records an admin marked visibleToCustomer ---- */
    match /{col}/{id} {
      allow read: if col in ['tdsRecords','agreements','rtgsRecords','gstRecords','nocRecords','complianceReviews'] &&
        (isAdmin() || (col in ['agreements','rtgsRecords','complianceReviews'] && ownsDoc() && resource.data.visibleToCustomer == true));
      allow create, update: if isAdmin() && col in ['tdsRecords','agreements','rtgsRecords','gstRecords','nocRecords','complianceReviews'];
      allow delete: if false;
    }

    /* ---- Audit trail: append-only ---- */
    match /auditLogs/{id} { allow read: if isAdmin(); allow create: if isAdmin() && request.resource.data.actor == request.auth.uid; allow update, delete: if false; }

    match /admins/{uid} { allow read: if mine(uid); allow write: if false; }

    match /counters/{id} { allow read, write: if false; }
  }
}
